{
  "name": "pair-wise-gsb-55",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 18455",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 18455",
    "test:logic": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.tmp/smoke.mjs --log-level=warning && node node_modules/.tmp/smoke.mjs",
    "test:e2e": "esbuild scripts/e2e.ts --bundle --platform=node --format=cjs --alias:@=./src --outfile=node_modules/.tmp/e2e.cjs --log-level=warning && node node_modules/.tmp/e2e.cjs",
    "test": "npm run test:logic && npm run test:e2e"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "@tanstack/vue-query": "5.64.2",
    "axios": "1.7.9",
    "element-plus": "2.9.3",
    "pinia": "2.3.0",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@vue/tsconfig": "0.7.0",
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vue-tsc": "2.2.0"
  }
}
